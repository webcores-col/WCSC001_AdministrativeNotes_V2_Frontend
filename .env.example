# URL interna del backend V2. En producción, la comunicación BFF→backend
# pasa por la red Docker "web" (no sale a Internet ni pasa por Caddy).
# En desarrollo local, apunta al backend corriendo en tu máquina.
BACKEND_URL=http://localhost:3000

# Secreto de cifrado de la sesión (cookie JWE de Auth.js). Generar con:
#   npx auth secret
AUTH_SECRET=

# URL pública de esta app (requerida por Auth.js para construir callbacks).
AUTH_URL=http://localhost:3001

# En producción, detrás de Caddy (reverse proxy), Auth.js necesita confiar
# explícitamente en los headers de host/proto del proxy. En desarrollo local
# (sin proxy) no hace falta.
AUTH_TRUST_HOST=true

# DSN de Sentry de este frontend (proyecto separado del backend). Vacío en
# desarrollo local desactiva el envío de eventos. Con NEXT_PUBLIC_ porque
# instrumentation-client.ts corre en el navegador (el DSN no es secreto: de
# todas formas termina expuesto en cualquier bundle de cliente que reporte
# errores del lado del browser).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Nivel de log de pino (server-side, JSON a stdout).
LOG_LEVEL=info

# Subida de source maps a Sentry en el build (opcional — sin
# SENTRY_AUTH_TOKEN el plugin la omite en vez de fallar el build). Generar
# el token en Sentry → Settings → Auth Tokens (scope project:releases).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Credenciales del usuario ADMIN semilla del backend, solo para
# `npm run test:e2e` (Playwright). Nunca usar credenciales reales de
# producción — apuntar siempre a un backend local/de pruebas.
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=
