# URL interna del backend V2. En producción, la comunicación BFF→backend
# pasa por la red Docker "web" (no sale a Internet ni pasa por Caddy).
# En desarrollo local, apunta al backend corriendo en tu máquina.
BACKEND_URL=http://localhost:3000

# Secreto de cifrado de la sesión (cookie JWE de Auth.js). Generar con:
#   npx auth secret
AUTH_SECRET=

# URL pública de esta app (requerida por Auth.js para construir callbacks).
AUTH_URL=http://localhost:3001

# DSN de Sentry de este frontend (proyecto separado del backend). Vacío en
# desarrollo local desactiva el envío de eventos.
SENTRY_DSN=
