      "get": {
        "operationId": "NotesController_findAll_v1",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Página (desde 1)",
            "schema": {
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "description": "Tamaño de página",
            "schema": {
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "associateId",
            "required": false,
            "in": "query",
            "description": "Filtra los pagarés de un asociado (deudor)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dateFrom",
            "required": false,
            "in": "query",
            "description": "Fecha del pagaré desde (inclusive)",
            "schema": {
              "example": "2026-01-01",
              "type": "string"
            }
          },
          {
            "name": "dateTo",
            "required": false,
            "in": "query",
            "description": "Fecha del pagaré hasta (inclusive)",
            "schema": {
              "example": "2026-12-31",
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "Orden `campo:direccion`",
            "schema": {
              "default": "noteDate:desc",
              "type": "string",
              "enum": [
                "noteDate:desc",
